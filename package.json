{
  "name": "vm-tipping",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "import:data": "node scripts/import-data.mjs",
    "prestart": "npm run import:data",
    "start": "ng serve",
    "prebuild": "npm run import:data",
    "build": "ng build",
    "postbuild": "node -e \"const fs=require('node:fs');fs.copyFileSync('dist/vm-tipping/browser/index.html','dist/vm-tipping/browser/404.html')\"",
    "build:pages": "npm run build -- --base-href /vm-tipping/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@helsevestikt/hviktor-angular": "^0.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.0"
  }
}
